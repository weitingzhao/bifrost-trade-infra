{
  "implement": [
    "cursor-agent",
    "-p",
    "--force",
    "--trust",
    "--output-format",
    "stream-json",
    "--workspace",
    "{workspace}",
    "Round {round}. Read and carry out {brief}"
  ],
  "verify": [
    "bash",
    "~/agent-work/verify-branch.sh",
    "{workspace}",
    "bifrost-platform"
  ],
  "review": [
    "codex",
    "exec",
    "--sandbox",
    "read-only",
    "--skip-git-repo-check",
    "-C",
    "{workspace}",
    "--output-last-message",
    "{report}",
    "Round {round}. Read {brief} and review the diff. The first non-empty line of the report must be exactly VERDICT: safe to merge or VERDICT: fix first. The last non-empty line must be exactly END OF REPORT."
  ],
  "who": {
    "implement": "Cursor",
    "verify": "verify-branch.sh",
    "review": "Codex"
  },
  "usual_min": {
    "implement": 30,
    "verify": 8,
    "review": 10
  },
  "pattern": {
    "implement": "cursor-agent",
    "verify": "verify-branch.sh",
    "review": "codex exec"
  }
}
