# Code-health ratchet baselines — see scan.sh
#
# RULE: these numbers may only go DOWN. scan.sh fails when a value exceeds its
# baseline, and tells you to lower the baseline when a value drops below it
# (an un-lowered baseline is slack that lets the debt creep back).
#
# Same contract as bifrost-trade-frontend/scripts/check-legacy-css.sh, whose
# RAW_PNL_PALETTE_BASELINE went 64 -> 37 under exactly this rule.
#
# Measured by scan.sh itself. Do not hand-edit to a value you have not seen
# the script print.

# Distinct function names defined >3 times (tests and dunders excluded).
# Counts duplicated *concepts*, not copies: a 52nd `_run` does not trip this,
# but a newly duplicated name does.
#
# Frontend 12 -> 8 on 2026-08-31, from two separate causes. Keeping them apart
# matters: only one of them is actual repayment.
#   12 -> 10  real: the percentage formatters were unified on lib/format
#                   (fmtPctFromFraction / fmtPct1 / fmtPct2 / fmtPctSigned),
#                   retiring 13 local `fmtPct` definitions that carried two
#                   incompatible meanings.
#   10 ->  8  scope: the TS side now counts module-scope declarations only.
#                   Two indented in-component helpers stopped being counted.
#                   No code changed for those two.
DUP_FUNCS_FRONTEND_BASELINE=1
DUP_FUNCS_RESEARCH_BASELINE=26
# Trade OLTP + plugins — first measured 2026-08-31 (coverage expansion).
DUP_FUNCS_TRADE_API_BASELINE=6
DUP_FUNCS_TRADE_CORE_BASELINE=4
DUP_FUNCS_TRADE_WORKER_BASELINE=1
DUP_FUNCS_PLUGIN_BASELINE=0
DUP_FUNCS_MARKET_DATA_BASELINE=4
DUP_FUNCS_FLEX_QUERY_BASELINE=1

# Git-tracked source files over 800 lines.
OVERSIZED_PLATFORM_BASELINE=30
OVERSIZED_FRONTEND_BASELINE=6
OVERSIZED_RESEARCH_BASELINE=5
OVERSIZED_TRADE_API_BASELINE=3
OVERSIZED_TRADE_CORE_BASELINE=4
OVERSIZED_TRADE_WORKER_BASELINE=0
OVERSIZED_UI_BASELINE=1
OVERSIZED_PLUGIN_BASELINE=0
OVERSIZED_MARKET_DATA_BASELINE=5
OVERSIZED_FLEX_QUERY_BASELINE=0
# Infra governance host — first measured 2026-08-31 (workspace full coverage).
# Threshold 500 (not 800): YAML/shell/docs rarely reach product-code size.
OVERSIZED_INFRA_BASELINE=3
DUP_FUNCS_INFRA_SH_BASELINE=3
DUP_FUNCS_INFRA_PY_BASELINE=1

# src/api/*.ts modules with no runtime contract validation (withValidation +
# lib/schemas). Unvalidated modules have zero protection against backend drift
# once Research and Satellite release on independent chains.
UNVALIDATED_API_BASELINE=28

# Distinct bifrost-research image tags pinned across bifrost-research/k8s.
# Every extra tier is a component running code nobody is tracking.
#   3 -> 2  real: research-mcp had sat on 0.30.0 while everything else moved on.
#           The gap was not cosmetic — the Copilot's write tools run in that
#           Deployment, so the curator's batch pass was being validated by code
#           written before batch passes existed. Two tiers left: the app image
#           and its -dagster variant, which is a genuinely separate build.
RESEARCH_IMAGE_TIERS_BASELINE=2

# Page files loose at a domain's top level, summed across src/pages/*/.
# Measured after pages/research was grouped by its nav IA (27 -> 1).
FLAT_PAGES_FRONTEND_BASELINE=35
