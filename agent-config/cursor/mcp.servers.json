{
  "comment": "Cursor-side MCP template. Same servers as Claude .mcp.json except chat approval is absent. bifrost-platform and bifrost-kubernetes keep MCP_WRITES=on. Install with python3 agent-config/cursor/install-mcp.py (renders ${workspaceFolder} to the workspace root and merges into ~/.cursor/mcp.json). No token values here: each server pins PLATFORM_TOKEN_ENV_KEY and reads that key from its environment or the 0600 token file.",
  "mcpServers": {
    "bifrost-platform": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/platform/src/index.ts"
      ],
      "env": {
        "PLATFORM_API_URL": "http://192.168.10.100:30876",
        "PLATFORM_TOKEN_ENV_KEY": "PLATFORM_OPERATOR_TOKEN",
        "MCP_WRITES": "on"
      }
    },
    "bifrost-kubernetes": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/platform/src/index.ts"
      ],
      "env": {
        "PLATFORM_API_URL": "http://192.168.10.100:30876",
        "PLATFORM_TOKEN_ENV_KEY": "PLATFORM_OPERATOR_TOKEN",
        "MCP_BRIDGE_FOCUS": "kubernetes",
        "MCP_WRITES": "on"
      }
    },
    "bifrost-redis": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/platform/src/index.ts"
      ],
      "env": {
        "PLATFORM_API_URL": "http://192.168.10.100:30876",
        "MCP_BRIDGE_FOCUS": "redis",
        "PLATFORM_TOKEN_ENV_KEY": "PLATFORM_VIEWER_TOKEN"
      }
    },
    "bifrost-postgres": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/platform/src/index.ts"
      ],
      "env": {
        "PLATFORM_API_URL": "http://192.168.10.100:30876",
        "MCP_BRIDGE_FOCUS": "postgres",
        "PLATFORM_TOKEN_ENV_KEY": "PLATFORM_VIEWER_TOKEN"
      }
    },
    "bifrost-prometheus": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/platform/src/index.ts"
      ],
      "env": {
        "PLATFORM_API_URL": "http://192.168.10.100:30876",
        "MCP_BRIDGE_FOCUS": "prometheus",
        "PLATFORM_TOKEN_ENV_KEY": "PLATFORM_VIEWER_TOKEN"
      }
    },
    "bifrost-trade-api": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/trade/src/index.ts"
      ],
      "env": {
        "TRADE_API_GATEWAY": "http://192.168.10.73",
        "TRADE_API_GATEWAY_HOST": "stg.trader.bifrost.lan",
        "TRADE_AGENT_CATALOG_URL": "http://192.168.10.100:30876/api/v1/trade-agent/catalog"
      }
    },
    "bifrost-local": {
      "command": "npx",
      "args": [
        "tsx",
        "${workspaceFolder}/bifrost-platform/mcp/platform/src/index.ts"
      ],
      "env": {
        "PLATFORM_API_URL": "http://127.0.0.1:8780",
        "PLATFORM_TOKEN_ENV_KEY": "PLATFORM_OPERATOR_TOKEN",
        "MCP_BRIDGE_FOCUS": "local"
      }
    }
  }
}
