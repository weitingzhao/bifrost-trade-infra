# Exporter versions for the hosts outside the cluster (W-68 B4 ①). Sourced by
# install-linux.sh and install-mac.sh; nas/compose.yaml pins the same versions by
# image digest. Change them together, in one commit.
#
# node_exporter follows the cluster's DaemonSet (kube-prometheus-stack chart 88.1.3
# runs quay.io/prometheus/node-exporter:v1.12.1-distroless, read 2026-10-24), so the
# chart's node-exporter rules and dashboards see the same metric set everywhere.
# When the chart is upgraded and its node-exporter tag moves, move these too.
# Checksums are the release's sha256sums.txt
# (github.com/prometheus/node_exporter/releases/tag/v1.12.1, published 2026-07-14).
NODE_EXPORTER_VERSION=1.12.1
NODE_EXPORTER_SHA256_LINUX_AMD64=b51d8a76aa2a9156a55d501aca6276fae09e262259a5e4e831d2c2222f084e63
NODE_EXPORTER_SHA256_DARWIN_ARM64=35b246a34af55a8f0c3f11067f17aecf9836cfd4689bde364776b3a4ad3a84d6

# smartctl_exporter 0.14.0 (2025-04-22), not 0.15.0 (2026-10-07, two weeks old when
# this was written). Checksum from that release's sha256sums.txt.
SMARTCTL_EXPORTER_VERSION=0.14.0
SMARTCTL_EXPORTER_SHA256_LINUX_AMD64=875983cd27affc5a682401930e5a8eea3f06c325fe6d6a7228c5547d882685b3
