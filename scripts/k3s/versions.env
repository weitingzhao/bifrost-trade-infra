# Versions of the cluster components that are installed from an upstream URL.
# One place, read by the install scripts in this directory and by Renovate
# (renovate.json matches the `# renovate:` line above each value).
#
# These are what the cluster ran on 2026-11-13 (read with kubectl). Before that
# the scripts defaulted to `latest` / `stable`: re-running one would have
# upgraded the cluster to whatever upstream had published that day.
#
# Changing a value here changes nothing in the cluster. The upgrade is the
# install script, run by the Owner, after the change went through STG.

# renovate: datasource=github-releases depName=tektoncd/pipeline
TEKTON_PIPELINES_VERSION=v1.6.0
# renovate: datasource=github-releases depName=tektoncd/triggers
TEKTON_TRIGGERS_VERSION=v0.34.0
# renovate: datasource=github-releases depName=argoproj/argo-cd
ARGOCD_VERSION_PIN=v3.4.3
# Not installed yet (install-system-upgrade-controller.sh says why and when).
# renovate: datasource=github-releases depName=rancher/system-upgrade-controller
SYSTEM_UPGRADE_CONTROLLER_VERSION=v0.21.0
