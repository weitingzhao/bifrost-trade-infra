# The STG agentd on the agent host (Owner 2026-10-17). It polls the STG platform
# as host agent-06-stg and runs codex and the deterministic checks only, as its
# own user (not the PROD agentd's), behind the egress rules of
# bifrost-agent-egress.service. It cannot see the PROD agentd's home: every
# home but its own is an empty tmpfs here. Installed by prepare-agent-06.sh;
# the Owner enables it once its credentials are in place
# (OWNER-STEPS-agent-host-06.md).
[Unit]
Description=Bifrost agentd (STG platform, host agent-06-stg)
Wants=network-online.target
After=network-online.target bifrost-agent-egress.service
BindsTo=bifrost-agent-egress.service

[Service]
Type=simple
User=bifrost-agentd-stg
Group=bifrost-agentd-stg
WorkingDirectory=/home/bifrost-agentd-stg/agent-work/agentd
ExecStart=/usr/local/libexec/bifrost/agentd
Environment=HOME=/home/bifrost-agentd-stg
Environment=USER=bifrost-agentd-stg
Environment=LOGNAME=bifrost-agentd-stg
Environment=SHELL=/bin/bash
Environment=LANG=C.UTF-8
Environment=PATH=/home/bifrost-agentd-stg/.local/bin:/usr/local/go/bin:/usr/local/lib/nodejs/current/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENTD_PLATFORM=http://192.168.10.73:30878/api/v1/agentrt
Environment=AGENTD_HOST=agent-06-stg
Environment=AGENTD_TOOLS=exec:codex=openai,exec:deterministic=local
Environment=AGENTD_GIT_BASE=http://192.168.10.73:30300/bifrost
Environment=AGENTD_GIT_PUSH_BASE=http://192.168.10.73:30300/bifrost-agents
Environment=AGENTD_ROOT=/home/bifrost-agentd-stg/agent-work/agentd
Environment=AGENTD_TOKEN_FILE=/home/bifrost-agentd-stg/.config/bifrost/agentd.token
Environment=AGENTD_GIT_TOKEN_FILE=/home/bifrost-agentd-stg/.config/bifrost/agentd-git.token
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=90
UMask=0077
LimitNOFILE=65536
MemoryHigh=6G
MemoryMax=8G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/bifrost-agentd-stg
ReadWritePaths=/home/bifrost-agentd-stg
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
