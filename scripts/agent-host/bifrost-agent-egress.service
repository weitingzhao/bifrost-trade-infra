[Unit]
Description=Bifrost agent host: egress rules for the agentd users
Documentation=file:///etc/bifrost/agent-egress.nft
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/bifrost/agent-egress.nft
ExecReload=/usr/sbin/nft -f /etc/bifrost/agent-egress.nft
ExecStop=/usr/sbin/nft delete table inet bifrost_agent

[Install]
WantedBy=sysinit.target
