#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="$HOME/.bifrost-dev"
CONFIG_FILE="$CONFIG_DIR/sessions.yaml"
LOG_DIR="$CONFIG_DIR/logs"
STATE_DIR="$CONFIG_DIR/state"
TMUX_SESSION="bifrost"
WATCHDOG_WINDOW="_watchdog"
# Resolve symlink so ~/.local/bin/bdev → …/scripts/ still finds helpers.
_BDEV_SRC="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
  _BDEV_SRC="$(realpath "$_BDEV_SRC")"
elif [[ -L "$_BDEV_SRC" ]]; then
  _BDEV_SRC="$(readlink "$_BDEV_SRC")"
fi
SCRIPT_DIR="$(cd "$(dirname "$_BDEV_SRC")" && pwd)"
unset _BDEV_SRC
LOG_TEE="$SCRIPT_DIR/bdev-log-tee"
SUPERVISE="$SCRIPT_DIR/bdev-supervise"
# Soft cap for on-disk session logs (bdev-log-tee enforces while streaming).
BDEV_LOG_MAX_BYTES="${BDEV_LOG_MAX_BYTES:-5242880}"   # 5 MiB
BDEV_LOG_KEEP_BYTES="${BDEV_LOG_KEEP_BYTES:-2097152}" # 2 MiB after rotate
export BDEV_LOG_MAX_BYTES BDEV_LOG_KEEP_BYTES BDEV_STATE_DIR="$STATE_DIR"

# Watchdog defaults (overridable per session in sessions.yaml)
BDEV_HEALTH_INTERVAL="${BDEV_HEALTH_INTERVAL:-30}"
BDEV_HEALTH_FAIL_THRESHOLD="${BDEV_HEALTH_FAIL_THRESHOLD:-3}"

# ─── Helpers ──────────────────────────────────────────────────────────

die() { echo "ERROR: $*" >&2; exit 1; }

require_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed. Install with: brew install tmux"
}

require_config() {
  [[ -f "$CONFIG_FILE" ]] || die "Config not found: $CONFIG_FILE"
}

ensure_dirs() {
  mkdir -p "$LOG_DIR" "$STATE_DIR"
}

# Trim an existing log file if over max (used on start / log-gc).
trim_log_file() {
  local log_file="$1"
  [[ -f "$log_file" ]] || return 0
  python3 - "$log_file" "$BDEV_LOG_MAX_BYTES" "$BDEV_LOG_KEEP_BYTES" <<'PY'
import os, sys
path, max_b, keep_b = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
try:
    size = os.path.getsize(path)
except FileNotFoundError:
    raise SystemExit(0)
if size <= max_b:
    raise SystemExit(0)
keep = min(keep_b, max_b)
with open(path, "rb") as f:
    start = max(0, size - keep)
    f.seek(start)
    if start > 0:
        f.readline()
    data = f.read()
tmp = path + ".tmp"
with open(tmp, "wb") as f:
    f.write(b"[bdev] trimmed oversized log on start/gc\n")
    f.write(data)
os.replace(tmp, path)
print(f"trimmed {path}: {size} -> {len(data)} bytes", file=sys.stderr)
PY
}

log_bytes_of() {
  local log_file="$1"
  if [[ -f "$log_file" ]]; then
    stat -f%z "$log_file" 2>/dev/null || stat -c%s "$log_file" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

format_uptime() {
  local sec="$1"
  if [[ -z "$sec" ]] || (( sec < 0 )); then
    echo "-"
    return
  fi
  if (( sec >= 3600 )); then
    echo "$(( sec / 3600 ))h$(( (sec % 3600) / 60 ))m"
  elif (( sec >= 60 )); then
    echo "$(( sec / 60 ))m$(( sec % 60 ))s"
  else
    echo "${sec}s"
  fi
}

# Fallback when tmux lacks pane_start_time and state has no started_at (pre-C3 panes).
uptime_sec_from_pid() {
  local pid="$1"
  [[ -n "$pid" && "$pid" != "-" ]] || { echo 0; return; }
  python3 - "$pid" <<'PY'
import os, sys, time
pid = int(sys.argv[1])
# macOS: sysctl kern.proc.pid → not portable; use ps etime
import subprocess
try:
    out = subprocess.check_output(["ps", "-p", str(pid), "-o", "etime="], text=True).strip()
except Exception:
    print(0)
    raise SystemExit(0)
if not out:
    print(0)
    raise SystemExit(0)
# [[dd-]hh:]mm:ss
parts = out.replace("-", ":").split(":")
parts = [int(p) for p in parts]
sec = 0
if len(parts) == 4:  # dd:hh:mm:ss
    sec = parts[0]*86400 + parts[1]*3600 + parts[2]*60 + parts[3]
elif len(parts) == 3:
    sec = parts[0]*3600 + parts[1]*60 + parts[2]
elif len(parts) == 2:
    sec = parts[0]*60 + parts[1]
elif len(parts) == 1:
    sec = parts[0]
print(max(0, sec))
PY
}

read_state_field() {
  local name="$1"
  local field="$2"
  local default="${3:-0}"
  python3 - "$STATE_DIR/${name}.json" "$field" "$default" <<'PY'
import json, os, sys
path, field, default = sys.argv[1], sys.argv[2], sys.argv[3]
if not os.path.isfile(path):
    print(default)
    raise SystemExit(0)
try:
    with open(path) as f:
        data = json.load(f)
    val = data.get(field, default)
    if isinstance(val, bool):
        print("1" if val else "0")
    else:
        print(val if val is not None else default)
except Exception:
    print(default)
PY
}

# Parse sessions.yaml via python3 (stdlib only, no PyYAML needed).
# Outputs lines:
# name|label|cwd|command|ports|health_url|group|restart|restart_delay|restart_max_delay|restart_max_failures|health_interval|health_fail_threshold
parse_sessions() {
  python3 << 'PYEOF'
import os, re

config_file = os.path.expanduser("~/.bifrost-dev/sessions.yaml")
with open(config_file) as f:
    text = f.read()

current_name = None
sessions = {}

for line in text.splitlines():
    stripped = line.rstrip()
    if not stripped or stripped.startswith("#"):
        continue
    if stripped == "sessions:":
        continue
    m = re.match(r"^  (\S+):$", stripped)
    if m:
        current_name = m.group(1)
        sessions[current_name] = {}
        continue
    m = re.match(r"^    (\w+):\s*(.+)$", stripped)
    if m and current_name:
        key, val = m.group(1), m.group(2).strip()
        if (val.startswith('"') and val.endswith('"')) or \
           (val.startswith("'") and val.endswith("'")):
            val = val[1:-1]
        if val.startswith("[") and val.endswith("]"):
            inner = val[1:-1]
            val = [v.strip().strip('"').strip("'") for v in inner.split(",") if v.strip()]
        sessions[current_name][key] = val

def as_int(v, default):
    try:
        return int(str(v).strip())
    except Exception:
        return default

for name, s in sessions.items():
    cwd = os.path.expanduser(s.get("cwd", "."))
    ports_raw = s.get("ports", [])
    if isinstance(ports_raw, list):
        ports = ",".join(str(p) for p in ports_raw)
    else:
        ports = str(ports_raw)
    health = s.get("health_url", "")
    label = s.get("label", name)
    command = s.get("command", "")
    group = s.get("group", "")
    restart = str(s.get("restart", "no")).strip().lower() or "no"
    if restart in ("false", "0", "off", "none", ""):
        restart = "no"
    delay = as_int(s.get("restart_delay", 1), 1)
    max_delay = as_int(s.get("restart_max_delay", 30), 30)
    max_fails = as_int(s.get("restart_max_failures", 10), 10)
    health_interval = as_int(s.get("health_interval", os.environ.get("BDEV_HEALTH_INTERVAL", 30)), 30)
    health_fails = as_int(s.get("health_fail_threshold", os.environ.get("BDEV_HEALTH_FAIL_THRESHOLD", 3)), 3)
    print(
        f"{name}|{label}|{cwd}|{command}|{ports}|{health}|{group}|"
        f"{restart}|{delay}|{max_delay}|{max_fails}|{health_interval}|{health_fails}"
    )
PYEOF
  [[ ${PIPESTATUS[0]:-$?} -eq 0 ]] || die "Failed to parse $CONFIG_FILE"
}

# Get a single session field line. Args: session_name
get_session() {
  local target="$1"
  parse_sessions | while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
    if [[ "$name" == "$target" ]]; then
      echo "$name|$label|$cwd|$command|$ports|$health|$group|$restart|$delay|$max_delay|$max_fails|$health_interval|$health_fails"
      return 0
    fi
  done
}

session_exists() {
  tmux has-session -t "$TMUX_SESSION" 2>/dev/null
}

window_exists() {
  tmux list-windows -t "$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$1"
}

pane_is_alive() {
  local win="$1"
  local dead
  dead=$(tmux list-panes -t "$TMUX_SESSION:$win" -F '#{pane_dead}' 2>/dev/null | head -1)
  [[ "$dead" == "0" ]]
}

needs_watchdog() {
  parse_sessions | while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
    if [[ "$restart" == "on-failure" || "$restart" == "always" ]]; then
      echo yes
      return 0
    fi
    if [[ -n "$health" && "$restart" != "no" ]]; then
      echo yes
      return 0
    fi
  done
}

# Build a tmux pane command with Homebrew PATH + optional restart supervise + log tee.
#
# Important: do NOT put bdev-supervise on the left of a shell pipe to bdev-log-tee.
# If supervise exits while the tee side keeps the pane alive, auto-restart is lost.
# Instead, tee inside the supervised child (with pipefail) so supervise owns the lifecycle.
build_run_cmd() {
  local name="$1"
  local cwd="$2"
  local command="$3"
  local log_file="$4"
  local restart="$5"
  local delay="$6"
  local max_delay="$7"
  local max_fails="$8"

  # Append logs to file (no stdin pipe). Piping to bdev-log-tee lets orphan children that
  # inherit the write-end keep the tee alive forever, which freezes restart supervision.
  # Rotation: trim on start + watchdog periodic log-gc.
  local child
  child="export PATH=\"/opt/homebrew/bin:/usr/local/bin:\${HOME}/.local/bin:\${PATH}\"; export PYTHONUNBUFFERED=1; { ${command} ; } >> $(printf %q "$log_file") 2>&1"

  local run
  if [[ "$restart" == "no" ]]; then
    run="bash -lc $(printf %q "$child")"
  else
    run="$(printf %q "$SUPERVISE") $(printf %q "$name") $(printf %q "$restart") $(printf %q "$delay") $(printf %q "$max_delay") $(printf %q "$max_fails") -- bash -lc $(printf %q "$child")"
  fi

  printf "bash -lc %q" \
    "export PATH=\"/opt/homebrew/bin:/usr/local/bin:\${HOME}/.local/bin:\${PATH}\"; export PYTHONUNBUFFERED=1; export BDEV_STATE_DIR=$(printf %q "$STATE_DIR"); cd $(printf %q "$cwd") && exec ${run}"
}

clear_stop_flag() {
  rm -f "$STATE_DIR/${1}.stop"
}

set_stop_flag() {
  mkdir -p "$STATE_DIR"
  touch "$STATE_DIR/${1}.stop"
}

clear_crash_flag() {
  rm -f "$STATE_DIR/${1}.crashed"
  # Keep restarts count; clear crashed bit in json if present
  python3 - "$STATE_DIR/${1}.json" <<'PY'
import json, os, sys
path = sys.argv[1]
if not os.path.isfile(path):
    raise SystemExit(0)
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    raise SystemExit(0)
data["crashed"] = False
data["consecutive_failures"] = 0
data.pop("cooling_until", None)
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
}

# Kill leftover whole-package run_platform / suspended go run that race with split sessions.
cleanup_legacy_platform_orphans() {
  local pids
  # Combined launcher (no --console-only / --api-only)
  pids=$(pgrep -f '[Pp]ython.*scripts/run_platform\.py$' 2>/dev/null || true)
  if [[ -n "${pids:-}" ]]; then
    echo "⚠ cleaning legacy combined run_platform orphans: ${pids//$'\n'/ }"
    # shellcheck disable=SC2086
    kill -TERM $pids 2>/dev/null || true
    sleep 0.4
    # shellcheck disable=SC2086
    kill -KILL $pids 2>/dev/null || true
  fi
  # Suspended (T state) go run left by interrupted combined launcher
  pids=$(pgrep -f 'go run ./cmd/platform-api' 2>/dev/null || true)
  if [[ -n "${pids:-}" ]]; then
    local keep="" orphan=""
    for pid in $pids; do
      # Keep if parent tree includes bdev-supervise platform-api
      if ps -p "$pid" -o command= 2>/dev/null | grep -q .; then
        local ancestry
        ancestry=$(ps -o pid=,ppid=,command= -p "$pid" 2>/dev/null || true)
        local ppid
        ppid=$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ')
        local parent_cmd=""
        [[ -n "$ppid" ]] && parent_cmd=$(ps -p "$ppid" -o command= 2>/dev/null || true)
        if [[ "$parent_cmd" == *bdev-supervise*platform-api* ]] || [[ "$parent_cmd" == *run_platform_api* ]]; then
          keep+="$pid "
        else
          # Also check grandparent
          local gppid
          gppid=$(ps -p "$ppid" -o ppid= 2>/dev/null | tr -d ' ')
          local gcmd=""
          [[ -n "$gppid" ]] && gcmd=$(ps -p "$gppid" -o command= 2>/dev/null || true)
          if [[ "$gcmd" == *bdev-supervise* ]] || [[ "$parent_cmd" == *run_platform_api* ]] || [[ "$gcmd" == *run_platform_api* ]]; then
            keep+="$pid "
          else
            orphan+="$pid "
          fi
        fi
      fi
      unset ancestry
    done
    if [[ -n "${orphan// /}" ]]; then
      echo "⚠ cleaning orphan go run platform-api: $orphan"
      # shellcheck disable=SC2086
      kill -KILL $orphan 2>/dev/null || true
    fi
  fi
}

bump_health_fail() {
  local name="$1"
  python3 - "$STATE_DIR/${name}.json" <<'PY'
import json, os, sys, time
path = sys.argv[1]
data = {}
if os.path.isfile(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {}
n = int(data.get("health_failures", 0) or 0) + 1
data["health_failures"] = n
data["updated_at"] = int(time.time())
tmp = path + ".tmp"
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
print(n)
PY
}

reset_health_fail() {
  local name="$1"
  python3 - "$STATE_DIR/${name}.json" <<'PY'
import json, os, sys, time
path = sys.argv[1]
if not os.path.isfile(path):
    raise SystemExit(0)
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    raise SystemExit(0)
if int(data.get("health_failures", 0) or 0) == 0:
    raise SystemExit(0)
data["health_failures"] = 0
data["updated_at"] = int(time.time())
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
}

# ─── Commands ─────────────────────────────────────────────────────────

cmd_start() {
  require_tmux
  require_config
  ensure_dirs

  local target="${1:-}"

  if [[ ! -x "$LOG_TEE" ]]; then
    chmod +x "$LOG_TEE" 2>/dev/null || true
  fi
  [[ -x "$LOG_TEE" ]] || die "bdev-log-tee missing or not executable: $LOG_TEE"
  if [[ ! -x "$SUPERVISE" ]]; then
    chmod +x "$SUPERVISE" 2>/dev/null || true
  fi
  [[ -x "$SUPERVISE" ]] || die "bdev-supervise missing or not executable: $SUPERVISE"

  # Compat alias: old "platform" → start both API + Console
  if [[ "$target" == "platform" ]]; then
    echo "ℹ 'platform' session split — starting platform-api + platform-console"
    # Tear down legacy combined window if still present
    if session_exists && window_exists "platform"; then
      set_stop_flag "platform"
      tmux send-keys -t "$TMUX_SESSION:platform" C-c 2>/dev/null || true
      sleep 1
      if pane_is_alive "platform" 2>/dev/null; then
        tmux kill-pane -t "$TMUX_SESSION:platform" 2>/dev/null || true
      fi
      tmux kill-window -t "$TMUX_SESSION:platform" 2>/dev/null || true
      echo "■ platform — stopped legacy combined session"
    fi
    cleanup_legacy_platform_orphans
    cmd_start platform-api
    cmd_start platform-console
    ensure_watchdog
    return 0
  fi

  # When starting split API/console, also sweep legacy combined orphans.
  if [[ "$target" == "platform-api" || "$target" == "platform-console" ]]; then
    cleanup_legacy_platform_orphans
  fi

  while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
    if [[ -n "$target" && "$name" != "$target" ]]; then
      continue
    fi

    if window_exists "$name" && pane_is_alive "$name"; then
      echo "✓ $name — already running, skipping"
      continue
    fi

    clear_stop_flag "$name"
    clear_crash_flag "$name"

    local log_file="$LOG_DIR/${name}.log"
    trim_log_file "$log_file"
    local run_cmd
    run_cmd=$(build_run_cmd "$name" "$cwd" "$command" "$log_file" "$restart" "$delay" "$max_delay" "$max_fails")

    if ! session_exists; then
      tmux new-session -d -s "$TMUX_SESSION" -n "$name" "$run_cmd"
      echo "● $name — started (new session) [restart=$restart]"
    elif window_exists "$name"; then
      tmux respawn-pane -t "$TMUX_SESSION:$name" -k "$run_cmd"
      echo "● $name — respawned [restart=$restart]"
    else
      tmux new-window -t "$TMUX_SESSION" -n "$name" "$run_cmd"
      echo "● $name — started [restart=$restart]"
    fi
  done < <(parse_sessions)

  if [[ -n "$target" ]]; then
    local found
    found=$(get_session "$target")
    [[ -n "$found" ]] || die "Unknown service: $target"
  fi

  ensure_watchdog
}

ensure_watchdog() {
  local need
  need=$(needs_watchdog || true)
  [[ "$need" == *"yes"* ]] || return 0

  require_tmux
  ensure_dirs
  local run_cmd
  run_cmd=$(printf "bash -lc %q" \
    "export PATH=\"/opt/homebrew/bin:/usr/local/bin:\${HOME}/.local/bin:\${PATH}\"; exec $(printf %q "$SCRIPT_DIR/bdev") watchdog-loop")

  if ! session_exists; then
    return 0
  fi
  if window_exists "$WATCHDOG_WINDOW" && pane_is_alive "$WATCHDOG_WINDOW"; then
    return 0
  fi
  if window_exists "$WATCHDOG_WINDOW"; then
    tmux respawn-pane -t "$TMUX_SESSION:$WATCHDOG_WINDOW" -k "$run_cmd"
    echo "● $WATCHDOG_WINDOW — respawned"
  else
    tmux new-window -t "$TMUX_SESSION" -n "$WATCHDOG_WINDOW" "$run_cmd"
    echo "● $WATCHDOG_WINDOW — started (health + crash watchdog)"
  fi
}

cmd_stop() {
  require_tmux
  local target="${1:-}"

  if ! session_exists; then
    echo "No tmux session '$TMUX_SESSION' found."
    return 0
  fi

  if [[ "$target" == "platform" ]]; then
    echo "ℹ 'platform' session split — stopping platform-api + platform-console"
    if session_exists && window_exists "platform"; then
      set_stop_flag "platform"
      tmux send-keys -t "$TMUX_SESSION:platform" C-c 2>/dev/null || true
      sleep 1
      if pane_is_alive "platform" 2>/dev/null; then
        tmux kill-pane -t "$TMUX_SESSION:platform" 2>/dev/null || true
      fi
      tmux kill-window -t "$TMUX_SESSION:platform" 2>/dev/null || true
      echo "■ platform — stopped legacy combined session"
    fi
    cmd_stop platform-api
    cmd_stop platform-console
    return 0
  fi

  if [[ -n "$target" ]]; then
    if [[ "$target" == "$WATCHDOG_WINDOW" ]]; then
      set_stop_flag "$target"
      tmux send-keys -t "$TMUX_SESSION:$target" C-c 2>/dev/null || true
      echo "■ $target — stopped"
      return 0
    fi
    if ! window_exists "$target"; then
      set_stop_flag "$target"
      echo "✓ $target — not running"
      return 0
    fi
    set_stop_flag "$target"
    tmux send-keys -t "$TMUX_SESSION:$target" C-c 2>/dev/null || true
    sleep 1
    if pane_is_alive "$target" 2>/dev/null; then
      tmux send-keys -t "$TMUX_SESSION:$target" C-c 2>/dev/null || true
      sleep 1
    fi
    # If supervise ignored C-c, kill the pane process tree
    if pane_is_alive "$target" 2>/dev/null; then
      tmux kill-pane -t "$TMUX_SESSION:$target" 2>/dev/null || true
    fi
    echo "■ $target — stopped"
  else
    require_config
    parse_sessions | while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
      set_stop_flag "$name"
      if window_exists "$name"; then
        tmux send-keys -t "$TMUX_SESSION:$name" C-c 2>/dev/null || true
        echo "■ $name — stopping"
      fi
    done
    sleep 2
    parse_sessions | while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
      if window_exists "$name" && pane_is_alive "$name" 2>/dev/null; then
        tmux kill-pane -t "$TMUX_SESSION:$name" 2>/dev/null || true
      fi
    done
    if window_exists "$WATCHDOG_WINDOW"; then
      tmux send-keys -t "$TMUX_SESSION:$WATCHDOG_WINDOW" C-c 2>/dev/null || true
    fi
  fi
}

cmd_restart() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: bdev restart <name>"
  if [[ "$target" == "platform" ]]; then
    echo "ℹ 'platform' session split — restarting platform-api + platform-console"
    cleanup_legacy_platform_orphans
    cmd_restart platform-api
    cmd_restart platform-console
    return 0
  fi
  cmd_stop "$target"
  sleep 1
  cmd_start "$target"
}

cmd_status() {
  require_tmux
  require_config
  ensure_dirs

  local json_mode=false
  [[ "${1:-}" == "--json" ]] && json_mode=true

  local results=()
  local crash_hints=()

  while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
    local status="stopped"
    local pid="-"
    local uptime="-"
    local uptime_sec=0
    local health_ok="null"
    local restarts
    restarts=$(read_state_field "$name" "restarts" 0)
    local crashed
    crashed=$(read_state_field "$name" "crashed" 0)
    if [[ -f "$STATE_DIR/${name}.crashed" ]]; then
      crashed=1
    fi
    local last_exit
    last_exit=$(read_state_field "$name" "last_exit_code" null)
    local cooling_until
    cooling_until=$(read_state_field "$name" "cooling_until" 0)

    if session_exists && window_exists "$name"; then
      if pane_is_alive "$name" 2>/dev/null; then
        status="running"
        local pane_info
        pane_info=$(tmux list-panes -t "$TMUX_SESSION:$name" -F '#{pane_pid} #{pane_start_time}' 2>/dev/null | head -1)
        pid=$(echo "$pane_info" | awk '{print $1}')
        local start_ts
        start_ts=$(echo "$pane_info" | awk '{print $2}')
        # tmux 3.6+ may omit pane_start_time — fall back to supervise started_at, then ps etime
        if [[ -z "$start_ts" || "$start_ts" == "0" ]]; then
          start_ts=$(read_state_field "$name" "started_at" 0)
        fi
        if [[ -n "$start_ts" && "$start_ts" != "0" ]]; then
          local now
          now=$(date +%s)
          uptime_sec=$(( now - start_ts ))
          if (( uptime_sec < 0 )); then
            uptime_sec=0
          fi
          uptime=$(format_uptime "$uptime_sec")
        else
          uptime_sec=$(uptime_sec_from_pid "$pid")
          if (( uptime_sec > 0 )); then
            uptime=$(format_uptime "$uptime_sec")
          fi
        fi
      else
        status="dead"
      fi
    fi

    # CRASHED (incl. cooldown while supervise pane still alive)
    if [[ "$crashed" == "1" ]]; then
      status="crashed"
    fi

    if [[ "$status" == "running" && -n "$health" ]]; then
      if curl -sf -o /dev/null --max-time 2 "$health" 2>/dev/null; then
        health_ok="true"
      else
        health_ok="false"
      fi
    fi

    if $json_mode; then
      local ports_json
      ports_json=$(echo "$ports" | tr ',' '\n' | awk 'BEGIN{printf "["} NR>1{printf ","} {printf "%s",$1} END{printf "]"}')
      local json_status="$status"
      [[ "$json_status" == "dead" || "$json_status" == "crashed" ]] && json_status="error"
      local pid_json="null"
      if [[ "$status" == "running" && -n "$pid" && "$pid" != "-" ]]; then
        pid_json="$pid"
      fi
      # During cooldown, pane may still be alive (supervise sleeping) — still report pid.
      if [[ "$status" == "crashed" && -n "$pid" && "$pid" != "-" ]]; then
        pid_json="$pid"
      fi
      local log_file="$LOG_DIR/${name}.log"
      local log_bytes
      log_bytes=$(log_bytes_of "$log_file")
      local last_crash
      last_crash=$(read_state_field "$name" "last_crash_at" null)
      local crashed_json="false"
      [[ "$crashed" == "1" ]] && crashed_json="true"
      local last_exit_json="null"
      [[ "$last_exit" != "null" && -n "$last_exit" ]] && last_exit_json="$last_exit"
      local cooling_json="null"
      [[ "$cooling_until" != "0" && -n "$cooling_until" ]] && cooling_json="$cooling_until"
      results+=("{\"name\":\"$name\",\"label\":\"$label\",\"group\":\"$group\",\"ports\":$ports_json,\"status\":\"$json_status\",\"pid\":$pid_json,\"uptime_sec\":$uptime_sec,\"health_ok\":$health_ok,\"restarts\":$restarts,\"log_bytes\":$log_bytes,\"log_max_bytes\":$BDEV_LOG_MAX_BYTES,\"restart_policy\":\"$restart\",\"last_crash_at\":$last_crash,\"crashed\":$crashed_json,\"last_exit_code\":$last_exit_json,\"cooling_until\":$cooling_json}")
    else
      local health_str
      if [[ "$health_ok" == "true" ]]; then
        health_str="✓ healthy"
      elif [[ "$health_ok" == "false" ]]; then
        health_str="✗ unhealthy"
      else
        health_str="-"
      fi

      local status_icon
      case "$status" in
        running) status_icon="🟢" ;;
        dead|crashed) status_icon="🔴" ;;
        *)       status_icon="⚪" ;;
      esac

      local log_file="$LOG_DIR/${name}.log"
      local log_bytes
      log_bytes=$(log_bytes_of "$log_file")
      local log_note=""
      if (( log_bytes > BDEV_LOG_MAX_BYTES )); then
        log_note="  LOG: $((log_bytes / 1024 / 1024))MiB⚠"
      elif (( log_bytes > 0 )); then
        log_note="  LOG: $((log_bytes / 1024))KiB"
      fi

      local restart_note=""
      if [[ "$restart" != "no" ]]; then
        restart_note="  restart=$restart"
      fi
      if [[ "$restarts" != "0" ]]; then
        restart_note="${restart_note}  restarts=$restarts"
      fi
      if [[ "$status" == "crashed" ]]; then
        if [[ "$last_exit" != "null" && -n "$last_exit" ]]; then
          restart_note="${restart_note}  last_exit=$last_exit"
        fi
        if [[ "$cooling_until" != "0" && -n "$cooling_until" ]]; then
          local now_cool
          now_cool=$(date +%s)
          local left=$(( cooling_until - now_cool ))
          if (( left > 0 )); then
            restart_note="${restart_note}  cooldown=${left}s"
          fi
        fi
        crash_hints+=("$name")
      fi

      printf "%-18s %s %-8s  PID: %-7s  Uptime: %-10s  Ports: %-12s  Health: %s%s%s\n" \
        "$name" "$status_icon" "$status" "$pid" "$uptime" "$ports" "$health_str" "$log_note" "$restart_note"
    fi

  done < <(parse_sessions)

  if $json_mode; then
    local IFS=','
    echo "[${results[*]}]"
  elif (( ${#crash_hints[@]} > 0 )); then
    echo ""
    echo "⚠ CRASHED: ${crash_hints[*]}"
    echo "  Recover: bdev restart <name>   (or wait for supervise cooldown auto-retry)"
    echo "  Logs:    bdev logs <name> -n 80"
  fi
}

cmd_logs() {
  require_config

  local name=""
  local lines=50
  local follow=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) shift; lines="${1:-50}" ;;
      -f) follow=true ;;
      *)  name="$1" ;;
    esac
    shift
  done

  [[ -n "$name" ]] || die "Usage: bdev logs <name> [-n N] [-f]"

  if [[ "$name" == "platform" ]]; then
    die "Session 'platform' was split — use platform-api or platform-console"
  fi

  local found
  found=$(get_session "$name")
  [[ -n "$found" ]] || die "Unknown service: $name"

  local log_file="$LOG_DIR/${name}.log"
  if [[ ! -f "$log_file" ]]; then
    echo "No log file yet: $log_file"
    return 0
  fi

  if $follow; then
    tail -n "$lines" -f "$log_file"
  else
    tail -n "$lines" "$log_file"
  fi
}

cmd_log_gc() {
  require_config
  ensure_dirs
  local target="${1:-}"
  parse_sessions | while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
    if [[ -n "$target" && "$name" != "$target" ]]; then
      continue
    fi
    local log_file="$LOG_DIR/${name}.log"
    if [[ -f "$log_file" ]]; then
      trim_log_file "$log_file"
      echo "■ $name — log $(log_bytes_of "$log_file") bytes (max $BDEV_LOG_MAX_BYTES)"
    else
      echo "✓ $name — no log file"
    fi
  done
  if [[ -n "$target" ]]; then
    local found
    found=$(get_session "$target")
    [[ -n "$found" ]] || die "Unknown service: $target"
  fi
}

# Health + dead-pane watchdog (runs inside tmux window _watchdog).
# Avoid bash4 associative arrays — macOS /usr/bin/env bash may be 3.2.
cmd_watchdog_loop() {
  require_config
  ensure_dirs
  local stamp_dir="$STATE_DIR/_health_stamp"
  mkdir -p "$stamp_dir"
  echo "[bdev-watchdog] started (health poll + crash recovery)"
  while true; do
    local now
    now=$(date +%s)
    while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
      [[ "$restart" == "on-failure" || "$restart" == "always" ]] || continue

      # Skip if user requested stop
      if [[ -f "$STATE_DIR/${name}.stop" ]]; then
        continue
      fi
      # Skip while CRASHED / cooling — supervise owns cooldown retry; do not fight it.
      # If cooling_until elapsed and pane is dead, clear crash and respawn below.
      local is_crashed=0
      if [[ -f "$STATE_DIR/${name}.crashed" ]] || [[ "$(read_state_field "$name" "crashed" 0)" == "1" ]]; then
        is_crashed=1
      fi
      if [[ "$is_crashed" == "1" ]]; then
        local cool_until
        cool_until=$(read_state_field "$name" "cooling_until" 0)
        if [[ "$cool_until" != "0" ]] && (( now >= cool_until )) && \
           session_exists && window_exists "$name" && ! pane_is_alive "$name" 2>/dev/null; then
          echo "[bdev-watchdog] $name cooldown elapsed + pane dead — clearing crash and respawning"
          clear_crash_flag "$name"
        else
          continue
        fi
      fi

      # Dead pane with restart policy → respawn (supervise should keep pane alive;
      # this recovers if the whole wrapper died).
      if session_exists && window_exists "$name" && ! pane_is_alive "$name" 2>/dev/null; then
        echo "[bdev-watchdog] $name pane dead — respawning (policy=$restart)"
        clear_stop_flag "$name"
        local log_file="$LOG_DIR/${name}.log"
        local run_cmd
        run_cmd=$(build_run_cmd "$name" "$cwd" "$command" "$log_file" "$restart" "$delay" "$max_delay" "$max_fails")
        tmux respawn-pane -t "$TMUX_SESSION:$name" -k "$run_cmd" 2>/dev/null || true
        continue
      fi

      # Health liveness
      if [[ -z "$health" ]]; then
        continue
      fi
      if ! pane_is_alive "$name" 2>/dev/null; then
        continue
      fi
      local stamp_file="$stamp_dir/${name}"
      local last=0
      if [[ -f "$stamp_file" ]]; then
        last=$(cat "$stamp_file" 2>/dev/null || echo 0)
      fi
      if (( now - last < health_interval )); then
        continue
      fi
      echo "$now" > "$stamp_file"
      if curl -sf -o /dev/null --max-time 3 "$health" 2>/dev/null; then
        reset_health_fail "$name"
        continue
      fi
      local fails
      fails=$(bump_health_fail "$name")
      echo "[bdev-watchdog] $name health fail $fails/$health_fails ($health)"
      if (( fails >= health_fails )); then
        echo "[bdev-watchdog] $name unhealthy ×$fails — restarting"
        reset_health_fail "$name"
        clear_stop_flag "$name"
        set_stop_flag "$name"
        tmux send-keys -t "$TMUX_SESSION:$name" C-c 2>/dev/null || true
        sleep 1
        if pane_is_alive "$name" 2>/dev/null; then
          tmux kill-pane -t "$TMUX_SESSION:$name" 2>/dev/null || true
        fi
        sleep 1
        clear_stop_flag "$name"
        local log_file="$LOG_DIR/${name}.log"
        local run_cmd
        run_cmd=$(build_run_cmd "$name" "$cwd" "$command" "$log_file" "$restart" "$delay" "$max_delay" "$max_fails")
        if window_exists "$name"; then
          tmux respawn-pane -t "$TMUX_SESSION:$name" -k "$run_cmd" 2>/dev/null || true
        else
          tmux new-window -t "$TMUX_SESSION" -n "$name" "$run_cmd" 2>/dev/null || true
        fi
        python3 - "$STATE_DIR/${name}.json" <<'PY'
import json, os, sys, time
path = sys.argv[1]
data = {}
if os.path.isfile(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {}
data["restarts"] = int(data.get("restarts", 0) or 0) + 1
data["last_crash_at"] = int(time.time())
data["updated_at"] = int(time.time())
tmp = path + ".tmp"
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
      fi
    done < <(parse_sessions)
    # Periodic log trim (append-mode sessions no longer stream through bdev-log-tee).
    if (( now % 60 < 5 )); then
      parse_sessions | while IFS='|' read -r name label cwd command ports health group restart delay max_delay max_fails health_interval health_fails; do
        trim_log_file "$LOG_DIR/${name}.log" 2>/dev/null || true
      done
    fi
    sleep 5
  done
}

cmd_install_system() {
  require_config
  local name="${1:-}"
  [[ -n "$name" ]] || die "Usage: bdev install-system <name>"

  local line
  line=$(get_session "$name")
  [[ -n "$line" ]] || die "Unknown service: $name"

  IFS='|' read -r sname label cwd command ports health group restart delay max_delay max_fails health_interval health_fails <<<"$line"

  local agents_dir="$HOME/Library/LaunchAgents"
  mkdir -p "$agents_dir"
  local plist_id="com.bifrost.bdev.${name}"
  local plist_path="$agents_dir/${plist_id}.plist"
  local out_log="$LOG_DIR/${name}.launchd.out.log"
  local err_log="$LOG_DIR/${name}.launchd.err.log"
  ensure_dirs

  local keep_alive="true"
  if [[ "$restart" == "no" ]]; then
    keep_alive="false"
  fi

  local cmd_q
  cmd_q=$(printf %q "$command")
  local launch_cmd
  launch_cmd="export PATH=\"/opt/homebrew/bin:/usr/local/bin:\$HOME/.local/bin:\$PATH\"; export BDEV_STATE_DIR=\"$STATE_DIR\"; exec \"$SUPERVISE\" \"$name\" \"$restart\" \"$delay\" \"$max_delay\" \"$max_fails\" -- bash -lc $cmd_q"

  python3 - "$plist_path" "$plist_id" "$cwd" "$launch_cmd" "$keep_alive" "$out_log" "$err_log" <<'PY'
import sys, xml.sax.saxutils
path, label, cwd, launch_cmd, keep_alive, out_log, err_log = sys.argv[1:8]
esc = xml.sax.saxutils.escape
keep = "true" if keep_alive == "true" else "false"
body = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{esc(label)}</string>
  <key>WorkingDirectory</key>
  <string>{esc(cwd)}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>{esc(launch_cmd)}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <{keep}/>
  <key>StandardOutPath</key>
  <string>{esc(out_log)}</string>
  <key>StandardErrorPath</key>
  <string>{esc(err_log)}</string>
</dict>
</plist>
"""
with open(path, "w") as f:
    f.write(body)
print(path)
PY

  echo "Wrote $plist_path"
  echo "  restart policy: $restart (KeepAlive=$keep_alive)"
  echo "  logs: $out_log / $err_log"
  echo ""
  echo "Load with:"
  echo "  launchctl bootout gui/\$(id -u) $plist_path 2>/dev/null || true"
  echo "  launchctl bootstrap gui/\$(id -u) $plist_path"
  echo "  launchctl enable gui/\$(id -u)/$plist_id"
  echo "  launchctl kickstart -k gui/\$(id -u)/$plist_id"
  echo ""
  echo "Note: prefer tmux bdev sessions for interactive Dev Sessions UI;"
  echo "      launchd is an optional OS-level KeepAlive for a single service."
}

# ─── Usage ────────────────────────────────────────────────────────────

cmd_help() {
  cat <<'USAGE'
bdev — Bifrost Dev Sessions Manager

Usage:
  bdev start [name]           Start all services (or a specific one) in tmux
  bdev stop [name]            Stop all services (or a specific one)
  bdev restart <name>         Restart a single service
  bdev status [--json]        Show status of all services
  bdev logs <name> [-n N] [-f]  View service logs (default: last 50 lines)
  bdev log-gc [name]          Trim oversized on-disk logs to cap (default 5 MiB)
  bdev install-system <name>  Generate launchd KeepAlive plist (macOS)
  bdev help                   Show this help

Compat: name "platform" maps to platform-api + platform-console (split sessions).

sessions.yaml optional fields:
  restart: on-failure | always | no     (default: no)
  restart_delay: 1                      initial backoff seconds
  restart_max_delay: 30                 backoff cap
  restart_max_failures: 10              then CRASHED + cooldown, then retry
  health_url: http://127.0.0.1:8780/health
  health_interval: 30                   watchdog poll seconds
  health_fail_threshold: 3              consecutive fails → restart

CRASHED recovery:
  bdev restart <name>                   clears crash flags and respawns
  Or wait for supervise cooldown        (default max(120, max_delay*2) seconds)

Config:  ~/.bifrost-dev/sessions.yaml
Logs:    ~/.bifrost-dev/logs/<name>.log  (append mode; trimmed on start + watchdog)
State:   ~/.bifrost-dev/state/<name>.json
tmux:    session "bifrost" (+ window _watchdog when restart policies enabled)
Example: bifrost-trade-infra/config/sessions.yaml.example

prometheus-pf requires KUBECONFIG (default ~/.kube/bifrost-k3s.yaml via
scripts/run_prometheus_pf.sh). Do not run whole-package run_platform.py
alongside split platform-api / platform-console sessions.

Env:
  BDEV_LOG_MAX_BYTES   rotate/trim threshold (default 5242880 = 5 MiB)
  BDEV_LOG_KEEP_BYTES  bytes kept after rotate (default 2097152 = 2 MiB)
  BDEV_HEALTH_INTERVAL default health poll seconds (default 30)
  BDEV_CRASH_COOLDOWN  seconds to wait after max_failures before retry
USAGE
}

# ─── Main ─────────────────────────────────────────────────────────────

case "${1:-help}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status)  shift; cmd_status "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  log-gc)  shift; cmd_log_gc "$@" ;;
  install-system) shift; cmd_install_system "$@" ;;
  watchdog-loop) shift; cmd_watchdog_loop "$@" ;;
  help|--help|-h) cmd_help ;;
  *) die "Unknown command: $1 — run 'bdev help' for usage" ;;
esac
