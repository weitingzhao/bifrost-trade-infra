.env
.env.local
*.env.local
config/secrets/
k8s/base/secrets/bifrost-stg-secrets.yaml
k8s/base/secrets/bifrost-dev-secrets.yaml
k8s/base/secrets/bifrost-prod-secrets.yaml
k8s/cicd/gitea/secret.yaml
