nginx/generated/

# MkDocs
site/
.cache/
docs/Goal
docs/external/
.venv-docs/

# Local pg_dump / backup artefacts (do not commit)
backups/

# Agent 治理层：个人本地设置不入库（settings.json 是共享的，随库走）
agent-config/claude/settings.local.json

# Real token Secrets sit next to their .example in the platform overlays. Only
# convention kept them out before — copying an example to its real name was one
# `git add -A` from committing a credential.
k8s/overlays/platform-*/bifrost-platform-*-token*.yaml
k8s/overlays/platform-*/bifrost-platform-*-tokens.yaml
!k8s/overlays/platform-*/*.example.yaml
