{
	// Bifrost — multi-repo workspace
	// Explorer is a flat list; tier prefixes encode dependency planes:
	//   Shared → used by Ops + Trade (ui kit, deploy/infra)
	//   Ops    → control plane (platform + plugins / subcontractors)
	//   Trade  → data plane (SPA + core/socket/worker/api)
	//   Ref    → readonly external reference (no write / no deploy)
	"folders": [
		{
			"name": "🔗 Shared · ui — @bifrost/ui · Shell · Dense tokens",
			"path": "../bifrost-ui"
		},
		{
			"name": "🔗 Shared · infra — 部署 / Goal · Compose · Nginx · :8050",
			"path": "."
		},
		{
			"name": "🚀 Ops · platform — 控制面 · API :8780 · Console :5180",
			"path": "../bifrost-platform"
		},
		{
			"name": "🚀 Ops · plugin — IB Gateway · redis-ib",
			"path": "../bifrost-platform-plugin"
		},
		{
			"name": "🚀 Ops · market-data — 行情分包 · Polygon · :8790",
			"path": "../bifrost-platform-plugin-market-data"
		},
		{
			"name": "🚀 Ops · flex-query — IB Flex Query · brokerage · :8791",
			"path": "../bifrost-platform-plugin-flex-query"
		},
		{
			"name": "📈 Trade · frontend — 业务监控 UI · SPA :5173",
			"path": "../bifrost-trade-frontend"
		},
		{
			"name": "📈 Trade · core — 共享库 · bifrost_core",
			"path": "../bifrost-trade-core"
		},
		{
			"name": "📈 Trade · socket — IB / Massive 边缘 · Redis",
			"path": "../bifrost-trade-socket"
		},
		{
			"name": "📈 Trade · worker — Daemon + Celery",
			"path": "../bifrost-trade-worker"
		},
		{
			"name": "📈 Trade · api — FastAPI 9 域 · :8765–8773",
			"path": "../bifrost-trade-api"
		},
		{
			"name": "📚 Ref · research — 外部只读 · Analysis · 事件雷达",
			"path": "../Research-workspace"
		},
		{
			"path": "../bifrost-platform-plugin-flex-query"
		}
	],
	"settings": {
		"python.testing.pytestEnabled": true,
		"python.testing.unittestEnabled": false,
		"explorer.compactFolders": false,
		"explorer.sortOrder": "default",
		"explorer.excludeGitIgnore": false,
		"editor.formatOnSave": true,
		"[python]": {
			"editor.defaultFormatter": "charliermarsh.ruff"
		},
		"[typescript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode"
		},
		"[typescriptreact]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode"
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/__pycache__": true,
			"**/.venv": true,
			"**/dist": true,
			"**/build": true,
			"**/*.egg-info": true,
			"**/site": true
		},
		"files.readonlyInclude": {
			"📚 Ref · research — 外部只读 · Analysis · 事件雷达/**": true
		},
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.expand": false,
		"explorer.fileNesting.patterns": {
			"pyproject.toml": "requirements*.txt, setup.py, setup.cfg, uv.lock",
			"docker-compose.yml": "docker-compose*.yml, .env.example, Makefile",
			"package.json": "package-lock.json, yarn.lock, tsconfig*.json, vite.config.*",
			"CLAUDE.md": "README.md, AGENTS.md, LICENSE",
			"bifrost-trade.code-workspace": "docs/MIGRATION_TRACKING.md"
		}
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"charliermarsh.ruff",
			"ms-python.mypy-type-checker",
			"esbenp.prettier-vscode",
			"dbaeumer.vscode-eslint",
			"ms-azuretools.vscode-docker"
		]
	}
}