# Example ~/.bifrost-dev/sessions.yaml (Platform Service Reliability split).
# Copy/adapt to ~/.bifrost-dev/sessions.yaml on the Mac Pro / local Dev host.
#
# Compat: `bdev restart platform` still works — aliases to platform-api + platform-console.
#
# Optional fields:
#   restart: on-failure | always | no
#   restart_delay / restart_max_delay / restart_max_failures
#   health_interval / health_fail_threshold
#
# CRASHED: after restart_max_failures consecutive short exits, supervise cools down
# (default max(120s, restart_max_delay*2)) then clears the streak and retries.
# Manual recovery anytime: `bdev restart <name>` (clears ~/.bifrost-dev/state/<name>.crashed).
#
# Do NOT run whole-package `python3 scripts/run_platform.py` (api+console together)
# alongside these split sessions — use bdev / MCP restart_dev_session only.
#
# Frozen out of scope (this reliability pass):
#   - remediation-runner as a dedicated bdev session (keep commented; API may autostart)
#   - launchd as default bootstrap (bdev install-system remains optional)
#   - full timeline UI for session events

sessions:
  platform-api:
    label: "Platform API"
    cwd: ~/Desktop/stocks/bifrost-platform
    # Prefers api/bin/platform-api when built (`make build-api`); loads .env; exec's binary
    command: "./scripts/run_platform_api.sh"
    ports: [8780]
    health_url: "http://127.0.0.1:8780/health"
    group: ops
    restart: on-failure
    restart_delay: 1
    restart_max_delay: 30
    restart_max_failures: 10
    health_interval: 30
    health_fail_threshold: 3

  platform-console:
    label: "Platform Console"
    cwd: ~/Desktop/stocks/bifrost-platform
    # Host/port from bifrost-platform/.env (PLATFORM_CONSOLE_HOST=0.0.0.0)
    command: "python3 scripts/run_platform.py --console-only"
    ports: [5180]
    health_url: "http://127.0.0.1:5180"
    group: ops
    restart: on-failure
    restart_delay: 1
    restart_max_delay: 30
    restart_max_failures: 10
    health_interval: 30
    health_fail_threshold: 3

  # FROZEN: remediation-runner dedicated session — do not enable by default this pass.
  # remediation-runner:
  #   label: "Remediation Runner"
  #   cwd: ~/Desktop/stocks/bifrost-platform
  #   command: "python3 scripts/run_agent.py start --no-watch"
  #   ports: [8781]
  #   health_url: "http://127.0.0.1:8781/health"
  #   group: ops
  #   restart: on-failure

  # Requires KUBECONFIG (wrapper defaults to ~/.kube/bifrost-k3s.yaml).
  # Without it, kubectl falls back to 127.0.0.1:6443 and the session CRASHes.
  # Do not leave a manual `kubectl port-forward …9090` running — it fakes health.
  prometheus-pf:
    label: "Prometheus Port-Forward"
    cwd: ~/Desktop/stocks/bifrost-platform
    command: "./scripts/run_prometheus_pf.sh"
    ports: [9090]
    health_url: "http://127.0.0.1:9090/-/healthy"
    group: ops
    restart: always
    restart_delay: 2
    restart_max_delay: 60
    restart_max_failures: 40
    health_interval: 30
    health_fail_threshold: 3

  git-bridge:
    label: "Git Bridge Agent"
    cwd: ~/Desktop/stocks/bifrost-platform/agent/git-bridge
    command: "./start.sh"
    ports: [8785]
    health_url: "http://127.0.0.1:8785/health"
    group: ops
    restart: on-failure

  probe-bridge:
    label: "Satellite Probe Bridge"
    cwd: ~/Desktop/stocks/bifrost-platform/agent/satellite-probe-bridge
    command: "./start.sh"
    ports: [8786]
    health_url: "http://127.0.0.1:8786/health"
    group: ops
    restart: on-failure

  trade-ui:
    label: "Trade Frontend (Vite)"
    cwd: ~/Desktop/stocks/bifrost-trade-frontend
    command: "./run-local-ui.sh"
    ports: [5173]
    health_url: "http://127.0.0.1:5173"
    group: trade
    restart: on-failure
