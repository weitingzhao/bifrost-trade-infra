# The shape of Secret cicd/renovate. Never commit real values and never apply
# this file: the Owner creates the Secret with
#   scripts/gitea/put-renovate-tokens.sh
# which reads both tokens without echo, checks what each can do, and only then
# creates the Secret.
#
# gitea-token:      a token of the Gitea account `renovate-bot` (not an admin;
#                   write access to bifrost/bifrost-trade-infra only). Scopes:
#                   repository read and write, user read, issue read and write,
#                   organization read. It cannot push main: the account is not
#                   on main's push or merge whitelist.
# github-com-token: a fine-grained github.com token with "Public repositories
#                   (read-only)" and no other permission.
apiVersion: v1
kind: Secret
metadata:
  name: renovate
  namespace: cicd
type: Opaque
stringData:
  gitea-token: REPLACE_WITH_THE_GITEA_TOKEN
  github-com-token: REPLACE_WITH_THE_GITHUB_TOKEN
