# Copy to secret.yaml (do not commit) and apply it once, on a fresh cluster:
# kubectl apply -f k8s/cicd/gitea/secret.yaml -n cicd
# (Rotating the admin token later: scripts/gitea/rotate-admin-token.sh, which
# rewrites both Secrets below without printing either.)
#
# Gitea holds the primary copy of every repository (agent-config/gitea-primary.txt;
# CUT-gitea-primary-2026-10-17.md). People and agents push to Gitea; Tekton and
# Argo CD read it. GitHub is a public downstream copy: main and tags only, pushed
# by the cluster (k8s/cicd/github-sync, its token in Secret cicd/github-sync).
# Nothing is pulled from GitHub, so no GitHub token belongs here.
# LAN UI: http://192.168.10.73:30300
# In-cluster: http://gitea.cicd.svc.cluster.local:3000
apiVersion: v1
kind: Secret
metadata:
  name: gitea-bootstrap
  namespace: cicd
  labels:
    bifrost.io/component: gitea
type: Opaque
stringData:
  # Gitea admin API: the mirror-sync Task (now only checks a commit is on Gitea),
  # the GitHub sync (reads which repositories are primaries) and scripts/gitea/.
  # Gitea UI → Settings → Applications → Generate Token. Required scopes:
  #   read:user  write:user
  #   read:organization  write:organization
  #   read:repository  write:repository
  gitea_admin_token: "<GITEA_ADMIN_TOKEN>"
---
# Tekton git clone credentials (HTTP basic against in-cluster Gitea).
apiVersion: v1
kind: Secret
metadata:
  name: gitea-git-credentials
  namespace: cicd
  labels:
    bifrost.io/component: gitea
  annotations:
    tekton.dev/git-0: http://gitea.cicd.svc.cluster.local:3000
type: kubernetes.io/basic-auth
stringData:
  username: "<GITEA_CI_USER>"
  password: "<GITEA_CI_TOKEN_OR_PASSWORD>"
