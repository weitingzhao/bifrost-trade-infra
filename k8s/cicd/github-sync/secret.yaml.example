# The Owner's GitHub token for the sync (cut 9.12 B: fine-grained, all
# repositories of the account, Contents read and write). Never commit a real
# value. Create it from a terminal so the token is not on screen or in history
# (the exact command is in OWNER-STEPS-gitea-primary.md):
#   kubectl -n cicd create secret generic github-sync --from-file=token=/dev/stdin
apiVersion: v1
kind: Secret
metadata:
  name: github-sync
  namespace: cicd
type: Opaque
stringData:
  token: REPLACE_WITH_THE_TOKEN
